{
  "expo": {
    "name": "Business Partner",
    "slug": "business-partner",
    "scheme": "businesspartner",
    "version": "0.1.0",
  "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.merchant.businesspartner",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#1769E0"
    },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7FB"
        }
      ]
    ]
  }
}
